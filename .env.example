# -----------------------------------------------------------------------------
# SizeSnap environment configuration
# Copy this file to .env.local for local development, and configure the same
# keys in your hosting provider's environment settings for production.
# -----------------------------------------------------------------------------

# PUBLIC (exposed to the browser — do not put secrets here) -------------------

# The canonical production URL of your deployment (no trailing slash).
# Used for metadata, canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://sizesnap.example.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to use the project default.
NEXT_PUBLIC_GA_ID=G-1MX16G6167

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave blank to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Individual AdSense ad slot IDs for each placement. Leave blank to skip that placement.
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_MID_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BEFORE_RELATED=

# Maximum accepted upload size, in megabytes, per file type.
NEXT_PUBLIC_MAX_FILE_SIZE_IMAGE_MB=20
NEXT_PUBLIC_MAX_FILE_SIZE_PDF_MB=20

# Maximum number of files a user can compress in one batch (results are zipped together).
NEXT_PUBLIC_MAX_BATCH_FILES=10

# SERVER-ONLY (never exposed to the browser) -----------------------------------

# Destination address for the contact form (informational — Web3Forms below
# already has this address baked into its access key; change this only if you
# also update the CONTACT_EMAIL used for display copy on /contact).
CONTACT_EMAIL=thakurpratham15@gmail.com

# Web3Forms access key — this is what actually delivers /api/contact submissions
# by email. A working key (bound to thakurpratham15@gmail.com) already ships as
# the in-code default in src/app/api/contact/route.ts, so the form works out of
# the box. Set this to override it (e.g. to route mail to a different inbox —
# get a free key instantly at https://web3forms.com, no signup required).
WEB3FORMS_ACCESS_KEY=

# Alternative provider: if set, RESEND_API_KEY is used instead of Web3Forms
# (Web3Forms takes priority when both are present). Requires a Resend account.
RESEND_API_KEY=
